@@ -0,0 +1,14 @@
+"""PIS/PASEP validation."""
+
+_WEIGHTS = (3, 2, 9, 8, 7, 6, 5, 4, 3, 2)
+
+
+def is_valid_pis(value: str) -> bool:
+    """True for a PIS/PASEP with a valid check digit, formatted (`120.12345.67-2`) or not."""
+    if not isinstance(value, str):
+        return False
+    d = value.translate({ord(c): None for c in ".-"})
+    if len(d) != 11 or not (d.isascii() and d.isdigit()):
+        return False
+    digit = 11 - sum(int(n) * w for n, w in zip(d, _WEIGHTS)) % 11
+    return d[10] == str(0 if digit >= 10 else digit)
diff --git a/tests/test_pis.py b/tests/test_pis.py
