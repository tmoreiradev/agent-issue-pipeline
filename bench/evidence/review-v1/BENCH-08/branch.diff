+++ b/tests/test_pis.py
@@ -0,0 +1,26 @@
+import unittest
+
+from brdocs.pis import is_valid_pis
+
+
+class TestPis(unittest.TestCase):
+    def test_valid(self):
+        self.assertTrue(is_valid_pis("12012345672"))
+        self.assertFalse(is_valid_pis("12012345673"))
+
+    def test_formatted(self):
+        self.assertTrue(is_valid_pis("120.12345.67-2"))
+        self.assertFalse(is_valid_pis("120.12345.67-3"))
+
+    def test_digit_zero_rule(self):
+        self.assertTrue(is_valid_pis("12012345630"))  # sum % 11 == 1 -> 10 -> 0
+        self.assertTrue(is_valid_pis("12012345680"))  # sum % 11 == 0 -> 11 -> 0
+        self.assertFalse(is_valid_pis("12012345631"))
+
+    def test_wrong_length(self):
+        for v in ("", "1201234567", "120123456720"):
+            self.assertFalse(is_valid_pis(v))
+
+    def test_non_digits_never_raises(self):
+        for v in ("1201234567a", "abcdefghijk", "1201234567²", None, 12012345672):
+            self.assertFalse(is_valid_pis(v))
