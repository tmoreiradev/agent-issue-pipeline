+"""Split an amount into installments."""
+from decimal import Context, Decimal
+from functools import reduce
+
+
+def split_installments(total: Decimal, n: int) -> list[Decimal]:
+    """Split total into n two-decimal amounts summing to total; extra cents go first."""
+    if not isinstance(total, Decimal) or not total.is_finite() or total < 0:
+        raise ValueError(f"invalid total: {total!r}")
+    _, digits, exp = total.as_tuple()
+    if exp < -2:
+        raise ValueError(f"total has more than 2 decimal places: {total!r}")
+    if not isinstance(n, int) or isinstance(n, bool) or n < 1:
+        raise ValueError(f"invalid installment count: {n!r}")
+    # no int<->str conversion (4300-digit limit); own Context (exact) so the caller's prec is ignored
+    cents = reduce(lambda a, d: a * 10 + d, digits, 0) * 10 ** (exp + 2)
+    base, extra = divmod(cents, n)
+    ctx = Context(prec=len(digits) + max(exp, 0) + 4)
+    return [Decimal(base + (i < extra)).scaleb(-2, context=ctx) for i in range(n)]
diff --git a/tests/test_installments.py b/tests/test_installments.py
new file mode 100644
index 0000000..8daa861
